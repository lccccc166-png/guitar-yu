import 'package:flutter/material.dart';
import 'models.dart';

class TunerPage extends StatefulWidget {
  const TunerPage({super.key});

  @override
  State<TunerPage> createState() => _TunerPageState();
}

class _TunerPageState extends State<TunerPage> {
  bool _isListening = false;
  GuitarString _selectedString = standardTuning[0]; 
  double _centsDeviation = 0.0; 

  void _toggleListening() {
    setState(() {
      _isListening = !_isListening;
      if (_isListening) {
        _centsDeviation = 2.0; 
      } else {
        _centsDeviation = 0.0;
      }
    });
  }

  @override
  Widget build(BuildContext context) {
    String guideText = '';
    Color statusColor = Colors.white;

    if (!_isListening) {
      guideText = '点击下方按钮开始监听';
      statusColor = Colors.grey;
    } else if (_centsDeviation.abs() < 3.0) {
      guideText = '准确 (IN TUNE)';
      statusColor = Colors.white;
    } else if (_centsDeviation < 0) {
      guideText = '偏低 (需拧紧弦)';
      statusColor = Colors.grey.shade400;
    } else {
      guideText = '偏高 (需放松弦)';
      statusColor = Colors.grey.shade400;
    }

    return Scaffold(
      appBar: AppBar(
        title: const Text('吉他调音器', style: TextStyle(color: Colors.white, letterSpacing: 2)),
        backgroundColor: Colors.black,
        elevation: 0,
        centerTitle: true,
      ),
      body: Padding(
        padding: const EdgeInsets.symmetric(horizontal: 24.0),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Container(
              padding: const EdgeInsets.symmetric(vertical: 20, horizontal: 40),
              decoration: BoxDecoration(
                border: Border.all(color: Colors.white24, width: 1),
                borderRadius: BorderRadius.circular(16),
                color: const Color(0xFF0A0A0A),
              ),
              child: Column(
                children: [
                  const Text('当前目标音', style: TextStyle(color: Colors.grey, fontSize: 14)),
                  const SizedBox(height: 8),
                  Text(
                    _selectedString.name,
                    style: const TextStyle(fontSize: 42, fontWeight: FontWeight.w300, color: Colors.white, letterSpacing: 2),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 60),
            Column(
              children: [
                Text(
                  guideText,
                  style: TextStyle(fontSize: 22, fontWeight: FontWeight.w500, color: statusColor),
                ),
                const SizedBox(height: 30),
                SizedBox(
                  width: 280,
                  height: 30,
                  child: Stack(
                    alignment: Alignment.center,
                    children: [
                      Container(width: 2, height: 24, color: Colors.white),
                      AnimatedAlign(
                        alignment: Alignment((_centsDeviation / 50).clamp(-1.0, 1.0), 0),
                        duration: const Duration(milliseconds: 100),
                        child: Container(
                          width: 12,
                          height: 28,
                          decoration: BoxDecoration(
                            color: Colors.white,
                            borderRadius: BorderRadius.circular(4),
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
                const SizedBox(height: 10),
                const Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Text('-50', style: TextStyle(color: Colors.grey, fontSize: 12)),
                    Text('0 (标准)', style: TextStyle(color: Colors.grey, fontSize: 12)),
                    Text('+50', style: TextStyle(color: Colors.grey, fontSize: 12)),
                  ],
                ),
              ],
            ),
            const SizedBox(height: 60),
            Wrap(
              spacing: 10,
              runSpacing: 10,
              alignment: WrapAlignment.center,
              children: standardTuning.map((guitarString) {
                bool isSelected = _selectedString.name == guitarString.name;
                return ChoiceChip(
                  label: Text(guitarString.name),
                  selected: isSelected,
                  selectedColor: Colors.white,
                  backgroundColor: const Color(0xFF1A1A1A),
                  labelStyle: TextStyle(
                    color: isSelected ? Colors.black : Colors.white,
                    fontWeight: FontWeight.bold,
                  ),
                  onSelected: (selected) {
                    setState(() {
                      _selectedString = guitarString;
                    });
                  },
                );
              }).toList(),
            ),
            const Spacer(),
            SizedBox(
              width: double.infinity,
              height: 54,
              child: OutlinedButton(
                onPressed: _toggleListening,
                style: OutlinedButton.styleFrom(
                  side: const BorderSide(color: Colors.white, width: 1.5),
                  shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                  backgroundColor: _isListening ? Colors.white : Colors.transparent,
                ),
                child: Text(
                  _isListening ? '停止收音' : '开始调音',
                  style: TextStyle(
                    fontSize: 16,
                    fontWeight: FontWeight.bold,
                    color: _isListening ? Colors.black : Colors.white,
                  ),
                ),
              ),
            ),
            const SizedBox(height: 40),
          ],
        ),
      ),
    );
  }
}
