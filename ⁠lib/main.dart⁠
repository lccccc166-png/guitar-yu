import 'package:flutter/material.dart';

void main() {
  runApp(const GuitarTunerApp()); 
}

class GuitarTunerApp extends StatelessWidget {
  const GuitarTunerApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: '吉他调音器',
      debugShowCheckedModeBanner: false,
      theme: ThemeData.dark().copyWith(
        scaffoldBackgroundColor: const Color(0xFF121212),
        primaryColor: Colors.greenAccent,
      ),
      home: const TunerHomePage(),
    );
  }
}

class TunerHomePage extends StatefulWidget {
  const TunerHomePage({super.key});

  @override
  State<TunerHomePage> createState() => _TunerHomePageState();
}

class _TunerHomePageState extends State<TunerHomePage> {
  // 默认调音弦：E2, A2, D3, G3, B3, E4
  final List<String> strings = ['E2', 'A2', 'D3', 'G3', 'B3', 'E4'];
  int selectedStringIndex = 0;
  bool isHalfStepDown = false;

  @override
  Widget build(BuildContext context) {
    final currentNote = strings[selectedStringIndex];

    return Scaffold(
      appBar: AppBar(
        title: const Text('极简吉他调音器'),
        centerTitle: true,
        actions: [
          IconButton(
            icon: Icon(
              Icons.music_note,
              color: isHalfStepDown ? Colors.amber : Colors.white,
            ),
            tooltip: '降半音模式',
            onPressed: () {
              setState(() {
                isHalfStepDown = !isHalfStepDown;
              });
            },
          ),
        ],
      ),
      body: SafeArea(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.spaceEvenly,
          children: [
            // 模式提示
            if (isHalfStepDown)
              const Text(
                '已开启：降半音调音模式 (♭)',
                style: TextStyle(color: Colors.amber, fontSize: 16),
              ),

            // 中央发光音符显示
            Center(
              child: Container(
                width: 180,
                height: 180,
                decoration: BoxDecoration(
                  color: Colors.black87,
                  shape: BoxShape.circle,
                  border: Border.all(
                    color: Colors.greenAccent,
                    width: 4,
                  ),
                  boxShadow: [
                    BoxShadow(
                      color: Colors.greenAccent.withOpacity(0.6),
                      blurRadius: 25,
                      spreadRadius: 5,
                    ),
                  ],
                ),
                child: Center(
                  child: Text(
                    currentNote,
                    style: const TextStyle(
                      fontSize: 48,
                      fontWeight: FontWeight.bold,
                      color: Colors.greenAccent,
                    ),
                  ),
                ),
              ),
            ),

            // 吉他六根弦选择器
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceEvenly,
              children: List.generate(strings.length, (index) {
                final isSelected = index == selectedStringIndex;
                return GestureDetector(
                  onTap: () {
                    setState(() {
                      selectedStringIndex = index;
                    });
                  },
                  child: AnimatedContainer(
                    duration: const Duration(milliseconds: 200),
                    padding: const EdgeInsets.symmetric(
                      vertical: 12,
                      horizontal: 16,
                    ),
                    decoration: BoxDecoration(
                      color: isSelected
                          ? Colors.greenAccent
                          : Colors.grey.shade800,
                      borderRadius: BorderRadius.circular(10), 
                    ),
                    child: Text(
                      '${index + 1}弦\n${strings[index]}',
                      textAlign: TextAlign.center,
                      style: TextStyle(
                        fontSize: 14,
                        fontWeight: FontWeight.bold,
                        color: isSelected ? Colors.black : Colors.white,
                      ),
                    ),
                  ),
                );
              }),
            ),
          ],
        ),
      ),
    );
  }
}
